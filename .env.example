# Rotom Dex configuration. Copy to `.env` and edit; nothing here is read automatically, so export
# these in your process manager, your container runtime or your shell.

# ---- Database ---------------------------------------------------------------------------------
# The published snapshot the server reads. Read-only at request time; build it with `rotom import`.
ROTOM_DB=data/build/rotom.sqlite3

# ---- Web application --------------------------------------------------------------------------
# Where the built single-page application lives. The server starts fine without it (API only).
ROTOM_WEB_DIST=web/dist
# Set to 0 to serve the API alone and never mount the bundle.
ROTOM_SERVE_WEB=1
# Only needed when the browser and the API are on different origins. The documented arrangement --
# Vite's proxy in development, one origin in production -- needs no CORS at all.
# ROTOM_CORS_ORIGINS=https://example.com

# ---- Ask Rotom (optional) ---------------------------------------------------------------------
# Public visitors supply their own key through X-Rotom-Gemini-Key; no environment fallback.
# The Pokedex, team analysis and boss preparation never call a model.
ROTOM_CHAT_PROVIDER=gemini
ROTOM_CHAT_MODEL=gemini-3.8-flash
# Only for explicit local CLI live evaluation. Public API requests ignore this credential. Never commit it.
# ROTOM_GEMINI_API_KEY=
# ROTOM_GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Bounds, all enforced in code. The defaults are the values shipped in `rotom_dex/chat/config.py`.
ROTOM_CHAT_MAX_TURNS=4
ROTOM_CHAT_MAX_TOOL_CALLS=8
ROTOM_CHAT_MAX_CALLS_PER_TOOL=3
ROTOM_CHAT_PROVIDER_TIMEOUT=20
ROTOM_CHAT_DEADLINE=45
ROTOM_CHAT_MAX_MESSAGE_CHARS=2000
ROTOM_CHAT_MAX_HISTORY=12
ROTOM_CHAT_RATE_LIMIT=20
ROTOM_CHAT_RATE_WINDOW=60

# ---- Optional web research --------------------------------------------------------------------
# CLI research default. Public visitors choose per request. Research uses their key and quota;
# supported passages retain unreviewed source labels and are never written to the game database.
ROTOM_CHAT_RESEARCH=0
ROTOM_CHAT_MAX_RESEARCH_CALLS=2
ROTOM_CHAT_RESEARCH_TIMEOUT=15
# ROTOM_RESEARCH_MODEL=gemini-3.8-flash

# ---- Frontend build ---------------------------------------------------------------------------
# Only needed when the API is served from a different origin than the bundle.
# VITE_API_BASE=
